{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/DECK6/korean-elementary-learning-map/main/schema/kr-curriculum-standards.schema.json",
  "title": "Korean Elementary Learning Map — full-depth curriculum standards",
  "type": "object",
  "required": [
    "dataset",
    "taxonomyVersion",
    "locale",
    "country",
    "status",
    "verificationStatus",
    "sourceBasis",
    "textPolicy",
    "sourceCount",
    "sources",
    "curriculumCount",
    "standardCount",
    "microTopicCount",
    "mappingCount",
    "curricula",
    "standardMappings",
    "coverageGaps"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "dataset": { "type": "string" },
    "taxonomyVersion": { "type": "string" },
    "locale": { "const": "ko-KR" },
    "country": { "const": "KR" },
    "status": {
      "enum": ["seed", "staged-seed", "expanded-candidate-seed", "integrated-workstream-candidate"]
    },
    "verificationStatus": {
      "enum": ["official-source-checked", "public-doc-derived", "needs-official-code-check"]
    },
    "sourceBasis": { "type": "string", "minLength": 1 },
    "createdAt": { "type": "string" },
    "generatedAt": { "type": "string" },
    "textPolicy": {
      "type": "object",
      "required": ["standardTextIncluded", "summaryPolicy", "licensingStatus", "licenseCaution"],
      "properties": {
        "standardTextIncluded": { "const": false },
        "summaryPolicy": { "type": "string" },
        "licensingStatus": { "type": "string" },
        "licenseCaution": { "type": "string" }
      },
      "additionalProperties": false
    },
    "sourceCount": { "type": "integer", "minimum": 0 },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "curriculumCount": { "type": "integer", "minimum": 0 },
    "standardCount": { "type": "integer", "minimum": 0 },
    "microTopicCount": { "type": "integer", "minimum": 1500 },
    "mappingCount": { "type": "integer", "minimum": 0 },
    "coverageGapCount": { "type": "integer", "minimum": 0 },
    "curricula": {
      "type": "array",
      "items": { "$ref": "#/$defs/curriculum" }
    },
    "standardMappings": {
      "type": "array",
      "items": { "$ref": "#/$defs/standardMapping" }
    },
    "coverageGaps": {
      "type": "array",
      "items": { "$ref": "#/$defs/coverageGap" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "required": ["id", "name", "url", "accessDate", "usage", "sourceType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "accessDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "usage": { "type": "string", "minLength": 1 },
        "sourceType": {
          "enum": ["official-pdf", "official-inventory", "official-web", "repository-document"]
        },
        "publisher": { "type": "string", "minLength": 1 },
        "via": { "type": "string", "minLength": 1 },
        "subjectCode": { "type": "string", "minLength": 1 },
        "attachmentNo": { "type": "string", "minLength": 1 },
        "attachmentName": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fileSizeBytes": { "type": ["integer", "null"], "minimum": 1 },
        "pdfPages": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": true
    },
    "curriculum": {
      "type": "object",
      "required": [
        "id",
        "slug",
        "country",
        "subject",
        "subjectKorean",
        "schoolLevel",
        "version",
        "textIncluded",
        "verificationStatus",
        "standardCount",
        "standards"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^kr-2022-elem-" },
        "slug": { "type": "string" },
        "country": { "const": "KR" },
        "subject": { "type": "string" },
        "subjectKorean": { "type": "string" },
        "schoolLevel": { "const": "elementary" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "sourceIds": { "type": "array", "items": { "type": "string" } },
        "sourceUrls": { "type": "array", "items": { "type": "string" } },
        "textIncluded": { "const": false },
        "license": { "type": "string" },
        "verificationStatus": {
          "enum": ["official-source-checked", "public-doc-derived", "needs-official-code-check"]
        },
        "sourceBasis": { "type": "string" },
        "standardCount": { "type": "integer", "minimum": 0 },
        "standards": {
          "type": "array",
          "items": { "$ref": "#/$defs/standard" }
        }
      },
      "additionalProperties": false
    },
    "standard": {
      "type": "object",
      "required": [
        "key",
        "code",
        "subject",
        "subjectKorean",
        "gradeBand",
        "summary",
        "sourceTextIncluded",
        "verificationStatus",
        "sourceRefs",
        "sourceBasis"
      ],
      "properties": {
        "key": { "type": "string" },
        "code": { "type": "string", "pattern": "^\\[[246][국수과사영도실바슬즐건미음체][0-9]{2}-[0-9]{2}\\]$" },
        "subject": { "type": "string" },
        "subjectKorean": { "type": "string" },
        "gradeBand": { "type": "string" },
        "domain": { "type": ["string", "null"] },
        "domainKorean": { "type": ["string", "null"] },
        "summary": { "type": "string", "minLength": 1 },
        "sourceTextIncluded": { "const": false },
        "officialTextIncluded": { "type": ["boolean", "null"] },
        "sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "verificationStatus": {
          "enum": ["official-source-checked", "public-doc-derived", "needs-official-code-check"]
        },
        "sourceBasis": { "type": "string", "minLength": 1 },
        "evidence": { "type": ["array", "null"], "items": { "type": ["string", "object"] } },
        "workstreamFile": { "type": "string" }
      },
      "additionalProperties": true
    },
    "standardMapping": {
      "type": "object",
      "required": ["standardKey", "microTopicId", "relationship"],
      "properties": {
        "standardKey": { "type": "string" },
        "microTopicId": { "type": "string", "pattern": "^kr\\.mt\\." },
        "relationship": { "enum": ["introduces", "supports", "extends", "assesses"] },
        "confidence": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] },
        "workstreamFile": { "type": "string" }
      },
      "additionalProperties": true
    },
    "coverageGap": {
      "type": "object",
      "required": ["workstreamFile", "description"],
      "properties": {
        "workstreamFile": { "type": "string" },
        "subject": { "type": ["string", "null"] },
        "subjectKorean": { "type": ["string", "null"] },
        "id": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] },
        "description": { "type": "string", "minLength": 1 },
        "impact": { "type": ["string", "null"] },
        "sourceRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    }
  }
}
