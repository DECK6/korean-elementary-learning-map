<https://dexa.art/learnmap/#/topic/kr.mt.korean.grammar.1-2.2guk0401.01>
  a lm:LearningTopic ;
  lm:identifier "kr.mt.korean.grammar.1-2.2guk0401.01" ;
  dcterms:source <https://dexa.art/learnmap/#/source/kr-moe-2022-33-annex5-pdf>, <https://dexa.art/learnmap/#/source/kr-ncic-2022-elem-korean-attachment> ;
