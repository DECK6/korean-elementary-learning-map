<urn:fixture:evidence> a lm:EvidenceCriterion ;
  lm:identifier "fixture-evidence" ;
  lm:criterionText "Evidence is observable."@en .

<urn:fixture:prompt> a lm:AssessmentPrompt ;
  lm:identifier "fixture-prompt" ;
  lm:promptText "Demonstrate the fixture topic."@en .

