<urn:fixture:release> a lm:DatasetRelease ;
  lm:identifier "fixture-release" ;
  lm:rightsStatus <https://dexa.art/learnmap/vocab/#/RightsStatus/cleared> ;
  lm:officialTextIncluded false ;
  lm:hasCurriculum <urn:fixture:curriculum> ;
  lm:containsTopic
    <urn:fixture:topic-a>,
    <urn:fixture:topic-b>,
    <urn:fixture:topic-c>,
    <urn:fixture:topic-d>,
    <urn:fixture:topic-e> ;
  lm:hasCluster <urn:fixture:cluster> ;
  lm:reportsCoverageGap <urn:fixture:coverage-gap> ;
  lm:hasVerificationRecord <urn:fixture:vr-release> .

<urn:fixture:curriculum> a lm:Curriculum ;
  lm:identifier "fixture-curriculum" ;
  lm:preferredLabel "Fixture curriculum"@en ;
  lm:hasSubject <urn:fixture:subject> ;
  lm:hasGradeBand <urn:fixture:grade-1-2> ;
  lm:hasAchievementStandard <urn:fixture:standard> ;
  lm:officialTextIncluded false ;
  lm:hasVerificationRecord <urn:fixture:vr-curriculum> .

<urn:fixture:grade-1-2> a lm:GradeBand ;
  lm:identifier "1-2" ;
  lm:preferredLabel "Grades 1-2"@en .

<urn:fixture:subject> a lm:Subject ;
  lm:identifier "fixture-subject" ;
  lm:preferredLabel "Fixture subject"@en .

<urn:fixture:domain> a lm:LearningDomain ;
  lm:identifier "fixture-domain" ;
  lm:preferredLabel "Fixture domain"@en ;
  lm:hasSubject <urn:fixture:subject> .

<urn:fixture:standard> a lm:AchievementStandard ;
  lm:identifier "fixture-standard" ;
