<https://dexa.art/learnmap/#/release/kr-full-depth-v0.4>
  a lm:DatasetRelease, prov:Entity ;
  lm:identifier "kr-full-depth-v0.4" ;
  lm:status "formal-ontology-release" ;
  lm:rightsStatus <https://dexa.art/learnmap/vocab/#/RightsStatus/hold> ;
  lm:officialTextIncluded false ;
  lm:hasVerificationRecord <https://dexa.art/learnmap/#/verification/ontology-p3-formal-gates> ;
  dcterms:title "Korean Elementary Curriculum Learning Ontology — kr-full-depth-v0.4"@en ;
  dcterms:hasVersion "kr-full-depth-v0.4" ;
  dcterms:issued "2026-07-10"^^xsd:date ;
  dcterms:format "text/turtle", "application/ld+json" ;
  dcterms:conformsTo
    <https://dexa.art/learnmap/ontology/0.3.0-p3>,
    <https://dexa.art/learnmap/ontology/shapes.ttl> ;
