PREFIX lm: <https://dexa.art/learnmap/ontology#>

SELECT ?dependent ?prerequisite ?strength ?legacyStrength ?reason ?basis ?source
WHERE {
  ?assertion a lm:PrerequisiteAssertion ;
    lm:dependentTopic ?dependent ;
    lm:prerequisiteTopic ?prerequisite ;
    lm:prerequisiteStrength ?strength ;
    lm:legacyPrerequisiteStrength ?legacyStrength ;
    lm:prerequisiteReason ?reason ;
    lm:assertionBasis ?basis ;
    lm:assertionSource ?source .
}
ORDER BY ?dependent ?prerequisite ?strength
