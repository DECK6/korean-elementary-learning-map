@prefix lm: <https://dexa.art/learnmap/ontology#> .
@prefix core: <https://dexa.art/learnmap/ontology/k12-core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lm:DatasetReleaseShape a sh:NodeShape ;
  sh:targetClass lm:DatasetRelease ;
  sh:closed false ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:rightsStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://dexa.art/learnmap/vocab/#/RightsStatus/cleared> ] ;
  sh:property [ sh:path lm:officialTextIncluded ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ] ;
  sh:property [ sh:path lm:hasCurriculum ; sh:minCount 1 ; sh:class lm:Curriculum ] ;
  sh:property [ sh:path lm:containsTopic ; sh:minCount 1 ; sh:class lm:LearningTopic ] ;
  sh:property [ sh:path lm:hasCluster ; sh:minCount 1 ; sh:class lm:LearningCluster ] ;
  sh:property [ sh:path lm:reportsCoverageGap ; sh:minCount 1 ; sh:class lm:CoverageGap ] ;
  sh:property [ sh:path lm:hasVerificationRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:VerificationRecord ] ;
  sh:sparql [
    sh:message "directRequires must not contain a self edge."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE { FILTER EXISTS { ?topic lm:directRequires ?topic . } }
    """
  ] ;
  sh:sparql [
    sh:message "The asserted directRequires graph must be acyclic."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE { FILTER EXISTS { ?topic lm:directRequires+ ?topic . } }
    """
  ] ;
  sh:sparql [
    sh:message "Every directRequires edge must have a materialized inverse unlocks edge."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        FILTER EXISTS {
          ?dependent lm:directRequires ?prerequisite .
          FILTER NOT EXISTS { ?prerequisite lm:unlocks ?dependent . }
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "indirectRequires must be a non-direct path of at least two directRequires edges."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        FILTER EXISTS {
          ?dependent lm:indirectRequires ?prerequisite .
          FILTER (
            EXISTS { ?dependent lm:directRequires ?prerequisite } ||
            NOT EXISTS { ?dependent lm:directRequires/lm:directRequires+ ?prerequisite }
          )
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Every non-direct path of at least two edges must be materialized as indirectRequires."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        FILTER EXISTS {
          ?dependent lm:directRequires/lm:directRequires+ ?prerequisite .
          FILTER NOT EXISTS { ?dependent lm:directRequires ?prerequisite . }
          FILTER NOT EXISTS { ?dependent lm:indirectRequires ?prerequisite . }
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Every directRequires edge must have one authoritative PrerequisiteAssertion."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        FILTER EXISTS {
          ?dependent lm:directRequires ?prerequisite .
          FILTER NOT EXISTS {
            ?dependent lm:hasPrerequisiteAssertion ?assertion .
            ?assertion a lm:PrerequisiteAssertion ;
              lm:dependentTopic ?dependent ;
              lm:prerequisiteTopic ?prerequisite .
          }
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "Every alignedToStandard edge must have one authoritative StandardTopicAlignment."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        FILTER EXISTS {
          ?topic lm:alignedToStandard ?standard .
          FILTER NOT EXISTS {
            ?topic lm:hasStandardTopicAlignment ?alignment .
            ?alignment a lm:StandardTopicAlignment ;
              lm:alignmentTopic ?topic ;
              lm:alignmentStandard ?standard .
          }
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "A direct prerequisite pair must not have duplicate PrerequisiteAssertion records."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        FILTER EXISTS {
          ?left a lm:PrerequisiteAssertion ; lm:dependentTopic ?dependent ; lm:prerequisiteTopic ?prerequisite .
          ?right a lm:PrerequisiteAssertion ; lm:dependentTopic ?dependent ; lm:prerequisiteTopic ?prerequisite .
          FILTER (STR(?left) < STR(?right))
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "A topic-standard pair must not have duplicate StandardTopicAlignment records."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        FILTER EXISTS {
          ?left a lm:StandardTopicAlignment ; lm:alignmentTopic ?topic ; lm:alignmentStandard ?standard .
          ?right a lm:StandardTopicAlignment ; lm:alignmentTopic ?topic ; lm:alignmentStandard ?standard .
          FILTER (STR(?left) < STR(?right))
        }
      }
    """
  ] .

lm:CurriculumShape a sh:NodeShape ;
  sh:targetClass lm:Curriculum ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:hasSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:Subject ] ;
  sh:property [ sh:path lm:hasGradeBand ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:GradeBand ] ;
  sh:property [ sh:path lm:hasAchievementStandard ; sh:minCount 1 ; sh:class lm:AchievementStandard ] ;
  sh:property [ sh:path lm:officialTextIncluded ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ] ;
  sh:property [ sh:path lm:hasVerificationRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:VerificationRecord ] .

lm:GradeBandShape a sh:NodeShape ;
  sh:targetClass lm:GradeBand ;
  sh:property [
    sh:path lm:identifier ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in ( "1-2" "3-4" "5-6" "3-6" "1-6" ) ;
    sh:message "GradeBand identifier must be one of 1-2, 3-4, 5-6, 3-6, or 1-6."@en
  ] ;
  sh:property [ sh:path lm:preferredLabel ; sh:minCount 1 ; sh:uniqueLang true ] .

lm:SubjectShape a sh:NodeShape ;
  sh:targetClass lm:Subject ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:preferredLabel ; sh:minCount 1 ; sh:uniqueLang true ] .

lm:LearningDomainShape a sh:NodeShape ;
  sh:targetClass lm:LearningDomain ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:preferredLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
  sh:property [ sh:path lm:hasSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:Subject ] .

lm:AchievementStandardShape a sh:NodeShape ;
  sh:targetClass lm:AchievementStandard ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:hasSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:Subject ] ;
  sh:property [ sh:path lm:hasGradeBand ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:GradeBand ] ;
  sh:property [ sh:path lm:hasLearningDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:LearningDomain ] ;
  sh:property [ sh:path lm:officialTextIncluded ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ] ;
  sh:property [ sh:path lm:hasVerificationRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:VerificationRecord ] .

lm:LearningTopicShape a sh:NodeShape ;
  sh:targetClass lm:LearningTopic ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:preferredLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
  sh:property [ sh:path lm:hasSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:Subject ] ;
  sh:property [ sh:path lm:hasGradeBand ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:GradeBand ] ;
  sh:property [ sh:path lm:hasLearningDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:LearningDomain ] ;
  sh:property [
    sh:path lm:topicType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/LearningTopicType/conceptual>
      <https://dexa.art/learnmap/vocab/#/LearningTopicType/language>
      <https://dexa.art/learnmap/vocab/#/LearningTopicType/meta>
      <https://dexa.art/learnmap/vocab/#/LearningTopicType/procedural>
      <https://dexa.art/learnmap/vocab/#/LearningTopicType/representational>
    )
  ] ;
  sh:property [ sh:path lm:hasEvidenceCriterion ; sh:minCount 1 ; sh:class lm:EvidenceCriterion ] ;
  sh:property [ sh:path lm:hasAssessmentPrompt ; sh:minCount 1 ; sh:class lm:AssessmentPrompt ] ;
  sh:property [ sh:path lm:hasStandardTopicAlignment ; sh:minCount 1 ; sh:class lm:StandardTopicAlignment ] ;
  sh:property [ sh:path lm:officialTextIncluded ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ] ;
  sh:property [
    sh:path lm:decompositionKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/DecompositionKind/standard-core>
      <https://dexa.art/learnmap/vocab/#/DecompositionKind/subject-facet>
    )
  ] ;
  sh:property [
    sh:path lm:facetKey ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/facet/concept>
      <https://dexa.art/learnmap/vocab/facet/procedure>
      <https://dexa.art/learnmap/vocab/facet/representation>
      <https://dexa.art/learnmap/vocab/facet/application>
      <https://dexa.art/learnmap/vocab/facet/inquiry>
      <https://dexa.art/learnmap/vocab/facet/communication>
      <https://dexa.art/learnmap/vocab/facet/reflection>
      <https://dexa.art/learnmap/vocab/facet/core>
    )
  ] ;
  sh:property [ sh:path lm:standardKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:sourceStandardCode ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:hasVerificationRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:VerificationRecord ] .

lm:LearningClusterShape a sh:NodeShape ;
  sh:targetClass lm:LearningCluster ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:preferredLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
  sh:property [ sh:path lm:hasSubject ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:Subject ] ;
  sh:property [ sh:path lm:hasGradeBand ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:GradeBand ] ;
  sh:property [ sh:path lm:hasLearningDomain ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:LearningDomain ] ;
  sh:property [ sh:path lm:hasClusterMember ; sh:minCount 1 ; sh:class lm:LearningTopic ] .

lm:EvidenceCriterionShape a sh:NodeShape ;
  sh:targetClass lm:EvidenceCriterion ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:criterionText ; sh:minCount 1 ; sh:uniqueLang true ] .

lm:AssessmentPromptShape a sh:NodeShape ;
  sh:targetClass lm:AssessmentPrompt ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:promptText ; sh:minCount 1 ; sh:uniqueLang true ] .

lm:PrerequisiteAssertionShape a sh:NodeShape ;
  sh:targetClass lm:PrerequisiteAssertion ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:dependentTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:LearningTopic ] ;
  sh:property [ sh:path lm:prerequisiteTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:LearningTopic ] ;
  sh:property [
    sh:path lm:prerequisiteStrength ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/DependencyRequirementLevel/required>
      <https://dexa.art/learnmap/vocab/#/DependencyRequirementLevel/recommended>
    )
  ] ;
  sh:property [ sh:path lm:prerequisiteReason ; sh:minCount 1 ; sh:uniqueLang true ] ;
  sh:property [ sh:path lm:legacyPrerequisiteStrength ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "hard" "soft" ) ] ;
  sh:property [ sh:path lm:assertionBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:assertionSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:relationIdentifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^kr[.]dep[.][0-9a-f]{20}$" ] ;
  sh:property [
    sh:path lm:assertionLayer ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/RelationLayer/official>
      <https://dexa.art/learnmap/vocab/#/RelationLayer/pedagogical-candidate>
    )
  ] ;
  sh:property [
    sh:path lm:relationKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/RelationKind/required-prerequisite>
      <https://dexa.art/learnmap/vocab/#/RelationKind/recommended-before>
    )
  ] ;
  sh:property [
    sh:path lm:basisKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/BasisKind/official-source>
      <https://dexa.art/learnmap/vocab/#/BasisKind/official-code-order>
      <https://dexa.art/learnmap/vocab/#/BasisKind/decomposition-order>
      <https://dexa.art/learnmap/vocab/#/BasisKind/repository-authored>
      <https://dexa.art/learnmap/vocab/#/BasisKind/expert-authored>
    )
  ] ;
  sh:property [
    sh:path lm:scope ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/RelationScope/same-standard>
      <https://dexa.art/learnmap/vocab/#/RelationScope/same-domain>
      <https://dexa.art/learnmap/vocab/#/RelationScope/same-subject>
      <https://dexa.art/learnmap/vocab/#/RelationScope/cross-school-level>
    )
  ] ;
  sh:property [
    sh:path lm:reviewStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/ReviewStatus/candidate>
      <https://dexa.art/learnmap/vocab/#/ReviewStatus/internal-reviewed>
      <https://dexa.art/learnmap/vocab/#/ReviewStatus/subject-expert-reviewed>
      <https://dexa.art/learnmap/vocab/#/ReviewStatus/classroom-reviewed>
    )
  ] ;
  sh:property [ sh:path lm:hasVerificationRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:VerificationRecord ] ;
  sh:sparql [
    sh:message "official-source basis, required-prerequisite kind, a source locator, and an internal-or-better review status belong to the official layer only."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        $this lm:assertionLayer ?layer ; lm:basisKind ?basis ; lm:relationKind ?kind ; lm:reviewStatus ?review .
        BIND(?layer = <https://dexa.art/learnmap/vocab/#/RelationLayer/official> AS ?official)
        FILTER (
          (?basis = <https://dexa.art/learnmap/vocab/#/BasisKind/official-source>) != ?official ||
          (?kind = <https://dexa.art/learnmap/vocab/#/RelationKind/required-prerequisite>) != ?official ||
          (?review = <https://dexa.art/learnmap/vocab/#/ReviewStatus/candidate>) = ?official ||
          (?official && NOT EXISTS { $this lm:hasSourceLocator ?locator })
        )
      }
    """
  ] ;
  sh:sparql [
    sh:message "Legacy hard/soft strength must agree with normalized required/recommended strength."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        $this lm:legacyPrerequisiteStrength ?legacy ; lm:prerequisiteStrength ?normalized .
        BIND(IF(?legacy = "hard", "required", "recommended") AS ?term)
        FILTER (?normalized != IRI(CONCAT("https://dexa.art/learnmap/vocab/#/DependencyRequirementLevel/", ?term)))
      }
    """
  ] ;
  sh:sparql [
    sh:message "A prerequisite assertion must be linked from its dependent topic; only official-layer assertions may also carry a directRequires edge."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        $this lm:dependentTopic ?dependent ; lm:prerequisiteTopic ?prerequisite ; lm:assertionLayer ?layer .
        BIND(?layer = <https://dexa.art/learnmap/vocab/#/RelationLayer/official> AS ?official)
        FILTER (
          NOT EXISTS { ?dependent lm:hasPrerequisiteAssertion $this } ||
          (?official && NOT EXISTS { ?dependent lm:directRequires ?prerequisite }) ||
          (!?official && EXISTS { ?dependent lm:directRequires ?prerequisite })
        )
      }
    """
  ] .

lm:StandardTopicAlignmentShape a sh:NodeShape ;
  sh:targetClass lm:StandardTopicAlignment ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:alignmentTopic ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:LearningTopic ] ;
  sh:property [ sh:path lm:alignmentStandard ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:AchievementStandard ] ;
  sh:property [
    sh:path lm:alignmentKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/AlignmentKind/introduces>
      <https://dexa.art/learnmap/vocab/#/AlignmentKind/supports>
      <https://dexa.art/learnmap/vocab/#/AlignmentKind/extends>
      <https://dexa.art/learnmap/vocab/#/AlignmentKind/assesses>
    )
  ] ;
  sh:property [ sh:path lm:confidence ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minInclusive 0 ; sh:maxInclusive 1 ] ;
  sh:property [ sh:path lm:sourceAlignmentRelationship ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "introduces" "supports" "extends" "assesses" ) ] ;
  sh:property [ sh:path lm:sourceConfidenceValue ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:sourceAlignmentNote ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:sourceAlignmentRationale ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:note ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
  sh:property [ sh:path lm:confidenceDefaulted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path lm:defaultingPolicy ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:sourceVerificationStatus ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:verificationStatusDefaulted ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path lm:assertionBasis ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:assertionSource ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:hasVerificationRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:VerificationRecord ] ;
  sh:sparql [
    sh:message "Source alignment relationship must agree with the normalized AlignmentKind IRI."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        $this lm:sourceAlignmentRelationship ?relationship ; lm:alignmentKind ?kind .
        FILTER (?kind != IRI(CONCAT("https://dexa.art/learnmap/vocab/#/AlignmentKind/", ?relationship)))
      }
    """
  ] ;
  sh:sparql [
    sh:message "Defaulted alignment confidence must name alignment-confidence-default-v1; source confidence must not."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        $this lm:confidenceDefaulted ?defaulted .
        OPTIONAL { $this lm:defaultingPolicy ?policy . }
        FILTER (
          (?defaulted = true && (!BOUND(?policy) || ?policy != "alignment-confidence-default-v1")) ||
          (?defaulted = false && BOUND(?policy))
        )
      }
    """
  ] ;
  sh:sparql [
    sh:message "Source verification status, its default marker, and the linked VerificationRecord must agree."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        $this lm:verificationStatusDefaulted ?defaulted ;
          lm:hasVerificationRecord/lm:verificationStatus ?actualStatus .
        OPTIONAL { $this lm:sourceVerificationStatus ?sourceStatus . }
        BIND(IF(BOUND(?sourceStatus),
          IRI(CONCAT("https://dexa.art/learnmap/vocab/#/VerificationStatus/", ?sourceStatus)),
          <https://dexa.art/learnmap/vocab/#/VerificationStatus/workstream-reviewed>) AS ?expectedStatus)
        FILTER (
          ?actualStatus != ?expectedStatus ||
          (?defaulted = true && BOUND(?sourceStatus)) ||
          (?defaulted = false && !BOUND(?sourceStatus))
        )
      }
    """
  ] ;
  sh:sparql [
    sh:message "A standard alignment must be linked from its topic, and its binary alignedToStandard edge must agree with the authoritative assertion."@en ;
    sh:select """
      PREFIX lm: <https://dexa.art/learnmap/ontology#>
      SELECT $this WHERE {
        $this lm:alignmentTopic ?topic ; lm:alignmentStandard ?standard .
        FILTER NOT EXISTS {
          ?topic lm:hasStandardTopicAlignment $this ; lm:alignedToStandard ?standard .
        }
      }
    """
  ] .

lm:SourceDocumentShape a sh:NodeShape ;
  sh:targetClass lm:SourceDocument ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:preferredLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
  sh:property [ sh:path lm:sourceType ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:rightsStatus ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue <https://dexa.art/learnmap/vocab/#/RightsStatus/cleared> ; sh:message "SourceDocument rights status must remain cleared."@en ] ;
  sh:property [ sh:path lm:officialTextIncluded ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ; sh:hasValue false ; sh:message "SourceDocument must not claim that official text is included."@en ] ;
  sh:property [ sh:path lm:hasVerificationRecord ; sh:minCount 1 ; sh:maxCount 1 ; sh:class lm:VerificationRecord ] .

lm:SourceLocatorShape a sh:NodeShape ;
  sh:targetClass lm:SourceLocator ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:locatorValue ; sh:minCount 1 ; sh:datatype xsd:string ] .

lm:VerificationRecordShape a sh:NodeShape ;
  sh:targetClass lm:VerificationRecord ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [
    sh:path lm:verificationStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/VerificationStatus/not-checked>
      <https://dexa.art/learnmap/vocab/#/VerificationStatus/official-source-checked>
      <https://dexa.art/learnmap/vocab/#/VerificationStatus/public-doc-derived>
      <https://dexa.art/learnmap/vocab/#/VerificationStatus/verification-review-needed>
      <https://dexa.art/learnmap/vocab/#/VerificationStatus/workstream-reviewed>
    )
  ] .

lm:CoverageGapShape a sh:NodeShape ;
  sh:targetClass lm:CoverageGap ;
  sh:property [ sh:path lm:identifier ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path lm:gapCategory ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lm:gapSeverity ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ] ;
  sh:property [ sh:path lm:sourceGapSeverityPresent ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [
    sh:path lm:gapSeverity ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/vocab/#/GapSeverity/high>
      <https://dexa.art/learnmap/vocab/#/GapSeverity/medium>
      <https://dexa.art/learnmap/vocab/#/GapSeverity/low>
      <https://dexa.art/learnmap/vocab/#/GapSeverity/intentional>
    )
  ] ;
  sh:property [
    sh:path lm:gapStatus ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:datatype xsd:string ;
    sh:in ( "open" "needs-review" "resolved" "intentional" "out-of-scope" )
  ] ;
  sh:property [ sh:path lm:gapDescription ; sh:minCount 1 ; sh:uniqueLang true ] .

## K-12 core content shapes (ontology 0.4.0)
## contentKind, misconceptions, and the content source locator are core-namespace terms shared with
## the secondary map. A source-grounded draft must name the passage it was written from.

core:TopicContentShape a sh:NodeShape ;
  sh:targetSubjectsOf core:contentKind ;
  sh:property [
    sh:path core:contentKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/ontology/k12-core#content-mechanical-derivative>
      <https://dexa.art/learnmap/ontology/k12-core#content-source-grounded-draft>
    )
  ] ;
  sh:property [ sh:path core:misconception ; sh:datatype rdf:langString ] ;
  sh:property [ sh:path core:contentSourceLocator ; sh:maxCount 1 ; sh:class lm:SourceLocator ] ;
  sh:or (
    [ sh:property [
        sh:path core:contentKind ;
        sh:hasValue <https://dexa.art/learnmap/ontology/k12-core#content-mechanical-derivative> ] ]
    [ sh:property [ sh:path core:contentSourceLocator ; sh:minCount 1 ; sh:class lm:SourceLocator ] ]
  ) ;
  sh:message "A source-grounded draft topic must carry exactly one contentSourceLocator."@en .

core:FacetProjectionShape a sh:NodeShape ;
  sh:targetSubjectsOf core:facetKey ;
  sh:property [
    sh:path core:facetKey ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/ontology/k12-core#facet-concept>
      <https://dexa.art/learnmap/ontology/k12-core#facet-procedure>
      <https://dexa.art/learnmap/ontology/k12-core#facet-representation>
      <https://dexa.art/learnmap/ontology/k12-core#facet-application>
      <https://dexa.art/learnmap/ontology/k12-core#facet-inquiry>
      <https://dexa.art/learnmap/ontology/k12-core#facet-communication>
      <https://dexa.art/learnmap/ontology/k12-core#facet-reflection>
      <https://dexa.art/learnmap/ontology/k12-core#facet-core>
    )
  ] .

core:LayerProjectionShape a sh:NodeShape ;
  sh:targetSubjectsOf core:layerConcept ;
  sh:property [
    sh:path core:layerConcept ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/ontology/k12-core#layer-official>
      <https://dexa.art/learnmap/ontology/k12-core#layer-pedagogical-candidate>
    )
  ] .

## Source locator kind. STAS record locators are vocabulary-only in this release: the 2026-09-05
## source assessment allows recording where a STAS record was read, never its text.
core:SourceLocatorKindShape a sh:NodeShape ;
  sh:targetSubjectsOf core:locatorKind ;
  sh:property [
    sh:path core:locatorKind ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:in (
      <https://dexa.art/learnmap/ontology/k12-core#locator-printed-page>
      <https://dexa.art/learnmap/ontology/k12-core#locator-stas-record>
    )
  ] ;
  sh:or (
    [ sh:property [
        sh:path core:locatorKind ;
        sh:hasValue <https://dexa.art/learnmap/ontology/k12-core#locator-printed-page> ] ;
      sh:property [ sh:path lm:locatorValue ; sh:minCount 1 ] ]
    [ sh:property [
        sh:path core:locatorKind ;
        sh:hasValue <https://dexa.art/learnmap/ontology/k12-core#locator-stas-record> ] ;
      sh:property [ sh:path core:stasEndpoint ; sh:minCount 1 ; sh:maxCount 1 ] ;
      sh:property [ sh:path core:stasRecordId ; sh:minCount 1 ; sh:maxCount 1 ] ;
      sh:property [ sh:path core:collectedAt ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
      sh:property [ sh:path core:fileSha256 ; sh:minCount 1 ; sh:maxCount 1 ; sh:pattern "^[a-f0-9]{64}$" ] ]
  ) ;
  sh:message "A STAS record locator must carry endpoint, acvmtStdSeq, collection date, and response hash."@en .
